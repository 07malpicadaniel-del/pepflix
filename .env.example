# ==============================================================================
# Homelab Media Stack (2x Raspberry Pi ARM64 + K3s / Podman)
# Copia este archivo como `.env` y ajusta los valores a tu red local:
#   cp .env.example .env
# ==============================================================================

# --- Identidad y Permisos de Archivos (TRaSH Guides) ---
PUID=1000
PGID=1000
UMASK=002
TZ=Europe/Madrid

# --- Topología de los 2 Nodos Raspberry Pi ---
MASTER_HOSTNAME=rpi-master
MASTER_IP=192.168.1.50
WORKER_HOSTNAME=rpi-worker
WORKER_IP=192.168.1.51
LAN_SUBNET=192.168.1.0/24
SSH_USER=pi

# --- Almacenamiento Compartido NFS ---
# Punto de montaje idéntico en rpi-master y rpi-worker (obligatorio para hardlinks)
STORAGE_ROOT=/mnt/storage
# Opcional: dispositivo de disco externo en rpi-master (ej. /dev/sda1) si deseas
# montarlo automáticamente en /mnt/storage durante setup-nodes.sh
EXTERNAL_DISK_DEVICE=

# --- Dominios Locales (Traefik Ingress + Pi-hole / AdGuard / /etc/hosts) ---
BASE_DOMAIN=media.local
PORTAL_HOST=portal.media.local
JELLYFIN_HOST=jellyfin.media.local
NAVIDROME_HOST=music.media.local
THREADFIN_HOST=tv.media.local
PLAYER_HOST=player.media.local
EDU_HOST=edu.media.local
PROWLARR_HOST=prowlarr.media.local
SONARR_HOST=sonarr.media.local
RADARR_HOST=radarr.media.local
LIDARR_HOST=lidarr.media.local
BAZARR_HOST=bazarr.media.local
QBITTORRENT_HOST=downloads.media.local

# --- Imágenes Personalizadas (Módulos 5 y 6) ---
# Deja vacío IMAGE_REGISTRY para importación local en K3s (`localhost/...`)
# o especifica un registry privado (ej. `192.168.1.50:5000`)
IMAGE_REGISTRY=localhost
IMAGE_TAG=arm64
TARGET_PLATFORM=linux/arm64

# --- Claves API Opcionales para Widgets del Portal (Homepage) ---
# Se configuran tras el primer arranque dentro de Kubernetes Secret `homepage-secrets`
HOMEPAGE_VAR_JELLYFIN_API_KEY=REPLACE_WITH_JELLYFIN_API_KEY
HOMEPAGE_VAR_PROWLARR_API_KEY=REPLACE_WITH_PROWLARR_API_KEY
HOMEPAGE_VAR_SONARR_API_KEY=REPLACE_WITH_SONARR_API_KEY
HOMEPAGE_VAR_RADARR_API_KEY=REPLACE_WITH_RADARR_API_KEY
HOMEPAGE_VAR_LIDARR_API_KEY=REPLACE_WITH_LIDARR_API_KEY
HOMEPAGE_VAR_BAZARR_API_KEY=REPLACE_WITH_BAZARR_API_KEY
HOMEPAGE_VAR_QBIT_USER=admin
HOMEPAGE_VAR_QBIT_PASS=REPLACE_WITH_QBIT_PASSWORD
HOMEPAGE_VAR_NAVIDROME_USER=admin
HOMEPAGE_VAR_NAVIDROME_TOKEN=REPLACE_WITH_NAVIDROME_SUBSONIC_TOKEN
HOMEPAGE_VAR_NAVIDROME_SALT=REPLACE_WITH_NAVIDROME_SUBSONIC_SALT
